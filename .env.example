# HTTP
PORT=5177

# Queue and retries
MAX_CONCURRENT_JOBS=2
MAX_JOB_RETRIES=2

# Storage and retention
MAX_STORAGE_GB=10
MAX_UPLOAD_GB=2
JOB_DIR=data/jobs
JOB_TTL_MINUTES=60

# Linux system tools
FFMPEG_PATH=ffmpeg
YT_DLP_PATH=yt-dlp

# Required for administration from non-loopback addresses.
# Generate a long random value and never commit the real token.
ADMIN_TOKEN=

# Remote access is disabled and the server binds to 127.0.0.1 by default.
# To enable it, configure strong access profiles and HTTPS (built-in or proxy).
REMOTE_ACCESS_ENABLED=false
HOST=127.0.0.1
ACCESS_TOKENS_JSON=[]
MAX_ACTIVE_JOBS_PER_USER=4
RATE_LIMIT_MAX=120

# Built-in HTTPS. Configure both paths together.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Use true only when a trusted reverse proxy terminates HTTPS in front of the app.
TRUSTED_HTTPS_PROXY=false

# Optional outbound proxy used by provider requests and yt-dlp.
# HTTPS_PROXY=http://proxy.example:8080
# YT_DLP_PROXY=http://proxy.example:8080
